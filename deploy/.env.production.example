# Server .env für Produktion (ein Backend, mehrere Frontends über Nginx → /api)
# Kopieren nach Projekt-Root: cp deploy/.env.production.example .env

NODE_ENV=production
PORT=5000
# PostgreSQL aktiv → false setzen (sonst Login aus leerem server/data/users.json)
USE_MEMORY_DB=false
PERSIST_MEMORY_DATA=true
JWT_SECRET=DEIN-SICHERES-GEHEIMNIS-MIN-32-ZEICHEN
# Komma-getrennt: CORS + Socket.io (wenn Client wirklich cross-origin spricht; mit Nginx-Same-Origin meist unkritisch)
CLIENT_URL=https://az-intranet.de,https://az-schnelltest.berlin
