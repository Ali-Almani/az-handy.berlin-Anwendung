PORT=5000
NODE_ENV=development

# === IN-MEMORY MODUS (empfohlen ohne PostgreSQL) ===
# Daten in server/data/*.json - bleiben nach Neustart erhalten
USE_MEMORY_DB=true
PERSIST_MEMORY_DATA=true

# === PostgreSQL (nur wenn DB installiert und lauffähig) ===
# Wenn gesetzt und DB nicht erreichbar: Fallback auf In-Memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/az_handy_berlin
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=az_handy_berlin

JWT_SECRET=your-secret-key-change-in-production
# Ein Origin oder komma-getrennt mehrere (Produktion: beide Frontend-URLs)
CLIENT_URL=http://localhost:3000

# === PM2 Cluster-Mode ===
# PM2_INSTANCES=max   # Anzahl Worker (max = alle CPU-Kerne)
# REDIS_URL=redis://127.0.0.1:6379   # optional: Socket.io-Events über alle Worker
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
